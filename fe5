import L from \"leaflet\";
import \"leaflet/dist/leaflet.css\";

/**
 * Generic Leaflet map. Auto-fixes height bug, supports markers + click handler.
 * `markers`: [{lat,lng,color,popup,binId,onClick}]
 * `onMapClick`: function(latlng) called when user clicks empty map area
 */
export default function MapView({
  center, zoom = 12, markers = [], onMapClick, height = 460, fitBounds = false,
}) {
  const elRef = useRef(null);
  const mapRef = useRef(null);
  const layerRef = useRef(null);

  useEffect(() => {
    if (!elRef.current || mapRef.current) return;
    const map = L.map(elRef.current, { zoomControl: true }).setView(center, zoom);
    L.tileLayer(\"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\", {
      maxZoom: 19,
      attribution: \"© OpenStreetMap contributors\",
    }).addTo(map);
    mapRef.current = map;
    layerRef.current = L.layerGroup().addTo(map);
    setTimeout(() => map.invalidateSize(), 100);
    return () => {
      map.remove();
      mapRef.current = null;
    };
    // eslint-disable-next-line
  }, []);

  // Update view on city change
  useEffect(() => {
    if (!mapRef.current) return;
    mapRef.current.setView(center, zoom);
    setTimeout(() => mapRef.current?.invalidateSize(), 50);
  }, [center[0], center[1], zoom]);

  // Click handler
  useEffect(() => {
    if (!mapRef.current) return;
    const handler = (e) => onMapClick && onMapClick(e.latlng);
    mapRef.current.on(\"click\", handler);
    return () => mapRef.current && mapRef.current.off(\"click\", handler);
  }, [onMapClick]);

  // Markers
  useEffect(() => {
    if (!mapRef.current || !layerRef.current) return;
    layerRef.current.clearLayers();
    const bounds = [];
    markers.forEach((m) => {
      const color = m.color || \"#10b981\";
      const icon = L.divIcon({
        className: \"citibin-marker\",
        html: `<div style=\"background:${color};width:18px;height:18px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 8px rgba(0,0,0,0.4);\"></div>`,
        iconSize: [18, 18],
        iconAnchor: [9, 9],
      });
      const mk = L.marker([m.lat, m.lng], { icon }).addTo(layerRef.current);
      if (m.popup) mk.bindPopup(m.popup);
      if (m.onClick) mk.on(\"click\", () => m.onClick(m));
      bounds.push([m.lat, m.lng]);
    });
    if (fitBounds && bounds.length > 0) {
      mapRef.current.fitBounds(bounds, { padding: [40, 40] });
    }
  }, [markers, fitBounds]);

  return (
    <div
      ref={elRef}
      data-testid=\"leaflet-map\"
      style={{ height: `${height}px`, width: \"100%\", borderRadius: 14, overflow: \"hidden\" }}
    />
  );
}

export const fillColor = (fill) =>
  fill >= 80 ? \"#ef4444\" : fill >= 50 ? \"#f59e0b\" : \"#10b981\";
"
