
Action: file_editor create /app/frontend/src/pages/Analytics.jsx --file-text "import React, { useMemo } from \"react\";
import { useApp } from \"../AppContext\";
import {
  LineChart, Line, BarChart, Bar, PieChart, Pie, Cell, XAxis, YAxis,
  CartesianGrid, Tooltip, ResponsiveContainer, Legend
} from \"recharts\";

const COLORS = [\"#10b981\", \"#f59e0b\", \"#ef4444\", \"#3b82f6\", \"#8b5cf6\", \"#06b6d4\"];

export default function Analytics() {
  const { bins, zones, city } = useApp();

  // 24h demand curve (synthesized from city pattern)
  const hourly = useMemo(() => Array.from({ length: 24 }, (_, h) => {
    const peak = (h >= 8 && h <= 10) ? 90 : (h >= 12 && h <= 14) ? 85 : (h >= 19 && h <= 22) ? 95 : (h >= 1 && h <= 5) ? 12 : 50;
    return { hour: `${h}:00`, demand: peak + (h % 3) * 4 };
  }), [city]);

  const utilization = useMemo(() => {
    const heavy = bins.filter((b) => b.status === \"heavy\").length;
    const mod = bins.filter((b) => b.status === \"moderate\").length;
    const light = bins.filter((b) => b.status === \"light\").length;
    return [
      { name: \"Heavy\", value: heavy },
      { name: \"Moderate\", value: mod },
      { name: \"Light\", value: light },
    ];
  }, [bins]);

  const zoneScores = useMemo(
    () => zones.map((z) => ({ name: z.name.split(\" \").slice(0, 2).join(\" \"), waste: z.waste_score, complaints: z.complaints_count })),
    [zones]
  );

  return (
    <div className=\"space-y-6\">
      <div>
        <h1 className=\"text-3xl font-bold\">Analytics</h1>
        <p className=\"text-slate-500 dark:text-slate-400\">Operational insights for the selected city.</p>
      </div>

      <div className=\"grid lg:grid-cols-2 gap-4\">
        <Card title=\"24-hour Demand Curve\" testid=\"chart-demand\">
          <ResponsiveContainer width=\"100%\" height={280}>
            <LineChart data={hourly}>
              <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#e5e7eb\" />
              <XAxis dataKey=\"hour\" stroke=\"#64748b\" fontSize={11} />
              <YAxis stroke=\"#64748b\" fontSize={11} />
              <Tooltip />
              <Line type=\"monotone\" dataKey=\"demand\" stroke=\"#10b981\" strokeWidth={2.5} dot={false} />
            </LineChart>
          </ResponsiveContainer>
        </Card>

        <Card title=\"Bin Utilization\" testid=\"chart-util\">
          <ResponsiveContainer width=\"100%\" height={280}>
            <PieChart>
              <Pie data={utilization} dataKey=\"value\" nameKey=\"name\" outerRadius={100} label>
                {utilization.map((e, i) => (
                  <Cell key={i} fill={[\"#ef4444\", \"#f59e0b\", \"#10b981\"][i]} />
                ))}
              </Pie>
              <Tooltip />
              <Legend />
            </PieChart>
          </ResponsiveContainer>
        </Card>
      </div>

      <Card title=\"Zone Waste & Complaints\" testid=\"chart-zones\">
        <ResponsiveContainer width=\"100%\" height={320}>
          <BarChart data={zoneScores}>
            <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#e5e7eb\" />
            <XAxis dataKey=\"name\" stroke=\"#64748b\" fontSize={11} />
            <YAxis stroke=\"#64748b\" fontSize={11} />
            <Tooltip />
            <Legend />
            <Bar dataKey=\"waste\" fill=\"#10b981\" name=\"Waste Score\" />
            <Bar dataKey=\"complaints\" fill=\"#ef4444\" name=\"Complaints\" />
          </BarChart>
        </ResponsiveContainer>
      </Card>
    </div>
  );
}

const Card = ({ title, children, testid }) => (
  <div data-testid={testid} className=\"rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5\">
    <h3 className=\"font-semibold mb-4\">{title}</h3>
    {children}
  </div>
);
"
