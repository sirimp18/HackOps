@api_router.post(\"/simulation/place-bin\")
async def simulate_place(payload: BinPlaceRequest):
    \"\"\"For simulation: given a clicked map point, return area info + a synthetic bin.\"\"\"
    # find closest seeded bin
    bins = await db.bins.find({\"city\": payload.city}, {\"_id\": 0}).to_list(500)
    if not bins:
        raise HTTPException(404, \"City has no bins seeded\")
    def dist(b):
        return (b[\"lat\"] - payload.lat) ** 2 + (b[\"lng\"] - payload.lng) ** 2
    nearest = min(bins, key=dist)
    # Synthetic fill % based on a deterministic hash of lat/lng
    import hashlib
    h = int(hashlib.md5(f\"{payload.lat:.4f},{payload.lng:.4f}\".encode()).hexdigest(), 16)
    fill = h % 101
    status = \"heavy\" if fill >= 80 else (\"moderate\" if fill >= 50 else \"light\")
    return {
        \"lat\": payload.lat,
        \"lng\": payload.lng,
        \"area\": nearest[\"area\"],
        \"place\": nearest[\"place\"],
        \"city\": payload.city,
        \"nearest_bin_id\": nearest[\"id\"],
        \"capacity_liters\": 120,
        \"fill_percent\": fill,
        \"status\": status,  # heavy / moderate / light
    }


