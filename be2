@api_router.post(\"/alerts/{alert_id}/resolve\")
async def resolve_alert(alert_id: str):
    res = await db.alerts.update_one({\"id\": alert_id}, {\"$set\": {\"resolved\": True}})
    if res.matched_count == 0:
        raise HTTPException(404, \"Alert not found\")
    return {\"ok\": True}


