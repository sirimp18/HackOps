async def refresh_alerts_for_heavy_bins():
    \"\"\"Create dashboard alerts + worker notifications for any bin in 'heavy' status with no open alert.\"\"\"
    bins = await db.bins.find({\"status\": \"heavy\"}, {\"_id\": 0}).to_list(500)
    for b in bins:
        existing = await db.alerts.find_one({\"bin_id\": b[\"id\"], \"resolved\": False})
        if existing:
            continue
        alert = {
            \"id\": str(uuid.uuid4()),
            \"bin_id\": b[\"id\"],
            \"city\": b[\"city\"],
            \"area\": b[\"area\"],
            \"place\": b[\"place\"],
            \"fill_percent\": b[\"fill_percent\"],
            \"message\": f\"BIN {b['id']} at {b['place']} ({b['area']}) is {b['fill_percent']}% full — immediate attention needed.\",
            \"severity\": \"high\",
            \"resolved\": False,
            \"created_at\": datetime.now(timezone.utc).isoformat(),
        }
        await db.alerts.insert_one(alert)
        # Notify nearest worker for that area/city
        worker = await db.workers.find_one({\"city\": b[\"city\"]}, {\"_id\": 0})
        if worker:
            notif = {
                \"id\": str(uuid.uuid4()),
                \"worker_id\": worker[\"id\"],
                \"worker_name\": worker[\"name\"],
                \"worker_email\": worker[\"email\"],
                \"worker_phone\": worker[\"phone\"],
                \"bin_id\": b[\"id\"],
                \"city\": b[\"city\"],
                \"message\": f\"URGENT: Bin {b['id']} at {b['place']} is {b['fill_percent']}% full. Please collect ASAP.\",
                \"channel\": \"email\",
                \"delivered\": False,
                \"created_at\": datetime.now(timezone.utc).isoformat(),
            }
            await db.notifications.insert_one(notif)
            # Attempt SendGrid (stubbed if no key)
            await send_email_notification(notif)


async def send_email_notification(notif: dict):
    \"\"\"Send email via SendGrid if API key present, else log + mark stubbed.\"\"\"
    if not SENDGRID_API_KEY:
        logger.info(f\"[STUBBED EMAIL] To: {notif['worker_email']} | {notif['message']}\")
        await db.notifications.update_one(
            {\"id\": notif[\"id\"]},
            {\"$set\": {\"delivered\": False, \"delivery_note\": \"STUBBED - SendGrid key not configured\"}}
        )
        return
    try:
        import httpx
        payload = {
            \"personalizations\": [{\"to\": [{\"email\": notif[\"worker_email\"]}]}],
            \"from\": {\"email\": SENDGRID_FROM_EMAIL or \"alerts@citibin.app\"},
            \"subject\": f\"[CitiBin Alert] Bin {notif['bin_id']} needs attention\",
            \"content\": [{\"type\": \"text/plain\", \"value\": notif[\"message\"]}],
        }
        async with httpx.AsyncClient(timeout=10) as cli:
            r = await cli.post(
                \"https://api.sendgrid.com/v3/mail/send\",
                headers={\"Authorization\": f\"Bearer {SENDGRID_API_KEY}\",
                         \"Content-Type\": \"application/json\"},
                json=payload,
            )
            ok = 200 <= r.status_code < 300
            await db.notifications.update_one(
                {\"id\": notif[\"id\"]},
                {\"$set\": {\"delivered\": ok, \"delivery_note\": f\"SendGrid status {r.status_code}\"}}
            )
    except Exception as e:
        logger.exception(\"SendGrid send failed\")
        await db.notifications.update_one(
            {\"id\": notif[\"id\"]},
            {\"$set\": {\"delivered\": False, \"delivery_note\": f\"Error: {e}\"}}
        )


