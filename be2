async def _llm_chat(system: str, user: str) -> str:
    \"\"\"Run a single-turn Gemini 3 Flash call via emergentintegrations.\"\"\"
    from emergentintegrations.llm.chat import LlmChat, UserMessage
    chat = (LlmChat(api_key=EMERGENT_LLM_KEY,
                    session_id=f\"citibin-{uuid.uuid4()}\",
                    system_message=system)
            .with_model(\"gemini\", \"gemini-3-flash-preview\"))
    return await chat.send_message(UserMessage(text=user))


@api_router.post(\"/ai/generate-report\")
async def ai_generate_report(req: AIReportRequest):
    zone_str = \"\"
    if req.zone_id:
        z = await db.zones.find_one({\"id\": req.zone_id}, {\"_id\": 0})
        if z:
            zone_str = f\"Zone: {z['name']} (area: {z['area']}). Foot traffic: {z['foot_traffic']}/100. Commercial density: {z['commercial_density']}/100. Tags: {', '.join(z['tags'])}. Open complaints: {z['complaints_count']}.\"
    system = (
        \"You are CitiBin AI, an expert in urban smart-waste analytics for Indian cities \"
        \"(Bengaluru and Mysore). Produce a crisp, structured operational report with \"
        \"clear recommendations. Use markdown headings and bullet points.\"
    )
    user = (
        f\"City: {req.city.title()}.\n\"
        f\"{zone_str}\n\"
        f\"Additional context: {req.context or 'general operations'}.\n\n\"
        \"Generate: 1) Situation summary, 2) Top 3 risk hotspots, \"
        \"3) Bin placement recommendations with rationale, 4) Operational actions \"
        \"for the next 7 days, 5) KPIs to track.\"
    )
    text = await _llm_chat(system, user)
    return {\"report\": text, \"model\": \"gemini-3-flash-preview\"}


@api_router.post(\"/ai/evaluate-placement\")
async def ai_evaluate_placement(req: AIPlacementRequest):
    system = (
        \"You are CitiBin AI, evaluating proposed smart-bin placements in Indian cities. \"
        \"Be concise (max 250 words). Use markdown bullets.\"
    )
    user = (
        f\"Evaluate placing a new smart bin in {req.city.title()} at \"
        f\"({req.lat:.4f}, {req.lng:.4f}). Nearby existing bins: {req.nearby_bins}. \"
        f\"Estimated foot traffic: {req.foot_traffic}/100. \"
        \"Provide: verdict (RECOMMEND / RECONSIDER / REJECT), reasoning, expected utilization, \"
        \"and any operational caveats.\"
    )
    text = await _llm_chat(system, user)
    return {\"evaluation\": text, \"model\": \"gemini-3-flash-preview\"}


