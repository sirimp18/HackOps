@api_router.post(\"/events\")
async def create_event(payload: EventCreate):
    doc = payload.model_dump()
    doc[\"id\"] = f\"E-{payload.city[:3].upper()}-{str(uuid.uuid4())[:6]}\"
    doc[\"status\"] = \"Upcoming\"
    await db.events.insert_one(doc)
    doc.pop(\"_id\", None)
    return doc


