import {
  LayoutDashboard, BarChart3, FlaskConical, Sparkles, MapPin,
  MessageSquareWarning, CalendarDays, ClipboardList, Users, Sun, Moon, Bell
} from \"lucide-react\";

const NAV = [
  { to: \"/dashboard\", label: \"Dashboard\", icon: LayoutDashboard },
  { to: \"/analytics\", label: \"Analytics\", icon: BarChart3 },
  { to: \"/simulation\", label: \"Simulation\", icon: FlaskConical },
  { to: \"/ai-recs\", label: \"AI Recs\", icon: Sparkles },
  { to: \"/zones\", label: \"Zones\", icon: MapPin },
  { to: \"/complaints\", label: \"Complaints\", icon: MessageSquareWarning },
  { to: \"/events\", label: \"Events\", icon: CalendarDays },
  { to: \"/registry\", label: \"Registry\", icon: ClipboardList },
  { to: \"/workers\", label: \"Worker Contact\", icon: Users },
];

const LOGO_URL = \"https://customer-assets.emergentagent.com/job_92b306da-9945-4d48-b2e7-0b5f34ddb981/artifacts/2k6kxcss_ChatGPT%20Image%20May%208%2C%202026%2C%2011_22_55%20AM%20%281%29.png\";

export default function Layout({ children }) {
  const { city, setCity, cities, theme, setTheme, alerts } = useApp();
  const nav = useNavigate();

  return (
    <div className=\"min-h-screen flex bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100\">
      {/* Sidebar */}
      <aside className=\"hidden md:flex w-64 flex-col border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900\">
        <div
          className=\"px-5 py-5 border-b border-slate-200 dark:border-slate-800 cursor-pointer\"
          onClick={() => nav(\"/\")}
          data-testid=\"sidebar-logo\"
        >
          <div className=\"flex items-center gap-3\">
            <img src={LOGO_URL} alt=\"CitiBin\" className=\"w-10 h-10 rounded-lg object-contain bg-white\" />
            <div>
              <div className=\"font-extrabold text-xl tracking-tight text-emerald-600 dark:text-emerald-400\">CitiBin</div>
              <div className=\"text-[11px] text-slate-500\">Smart bins. Cleaner cities.</div>
            </div>
          </div>
        </div>
        <nav className=\"flex-1 p-3 space-y-1\">
          {NAV.map(({ to, label, icon: Icon }) => (
            <NavLink
              key={to} to={to}
              data-testid={`nav-${to.slice(1)}`}
              className={({ isActive }) =>
                `flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition ${
                  isActive
                    ? \"bg-emerald-500 text-white shadow\"
                    : \"text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-slate-800\"
                }`
              }
            >
              <Icon size={18} /> {label}
            </NavLink>
          ))}
        </nav>
        <div className=\"p-3 border-t border-slate-200 dark:border-slate-800\">
          <button
            onClick={() => setTheme(theme === \"dark\" ? \"light\" : \"dark\")}
            data-testid=\"theme-toggle\"
            className=\"w-full flex items-center justify-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 py-2 text-sm hover:bg-slate-50 dark:hover:bg-slate-800\"
          >
            {theme === \"dark\" ? <Sun size={16} /> : <Moon size={16} />}
            {theme === \"dark\" ? \"Light mode\" : \"Dark mode\"}
          </button>
        </div>
      </aside>

      {/* Main */}
      <div className=\"flex-1 flex flex-col min-w-0\">
        <header className=\"sticky top-0 z-20 backdrop-blur bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 px-4 md:px-8 py-3 flex items-center gap-3\">
          <div className=\"md:hidden flex items-center gap-2\">
            <img src={LOGO_URL} alt=\"CitiBin\" className=\"w-8 h-8 rounded-md\" />
            <span className=\"font-bold text-emerald-600\">CitiBin</span>
          </div>

          <div className=\"flex items-center gap-2 ml-auto\">
            <div className=\"hidden sm:flex bg-slate-100 dark:bg-slate-800 rounded-full p-1 text-sm\">
              {cities.map((c) => (
                <button
                  key={c.id}
                  data-testid={`city-pill-${c.id}`}
                  onClick={() => setCity(c.id)}
                  className={`px-4 py-1.5 rounded-full font-medium transition ${
                    city === c.id ? \"bg-emerald-500 text-white\" : \"text-slate-600 dark:text-slate-300\"
                  }`}
                >
                  {c.name}
                </button>
              ))}
            </div>
            <div className=\"relative\" data-testid=\"alert-bell\">
              <Bell size={20} />
              {alerts.length > 0 && (
                <span className=\"absolute -top-1 -right-1 bg-red-500 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center\">
                  {alerts.length}
                </span>
              )}
            </div>
          </div>
        </header>

        {/* Mobile city selector */}
        <div className=\"sm:hidden px-4 pt-3\">
          <select
            value={city} onChange={(e) => setCity(e.target.value)}
            data-testid=\"city-mobile-select\"
            className=\"w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 text-sm\"
          >
            {cities.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
        </div>

        <main className=\"flex-1 px-4 md:px-8 py-6 max-w-[1500px] w-full mx-auto\">
          {children}
        </main>
      </div>
    </div>
  );
}
"
