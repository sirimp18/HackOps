      setComplaints(co.data);
      setAlerts(al.data);
      setNotifications(nt.data);
    } catch (err) {
      console.error(\"refresh failed\", err);
    }
  }, [city]);

  useEffect(() => {
    refresh();
  }, [refresh]);

  return (
    <AppCtx.Provider
      value={{
        city, setCity, theme, setTheme, cities,
        bins, zones, workers, events, complaints, alerts, notifications,
        refresh,
      }}
    >
      {children}
    </AppCtx.Provider>
  );
};
