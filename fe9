
Action: file_editor create /app/frontend/src/pages/AIRecs.jsx --file-text "import React, { useState } from \"react\";
import axios from \"axios\";
import { useApp, API } from \"../AppContext\";
import { Sparkles, FileText } from \"lucide-react\";

export default function AIRecs() {
  const { city, zones } = useApp();
  const [zoneId, setZoneId] = useState(\"\");
  const [report, setReport] = useState(\"\");
  const [loading, setLoading] = useState(false);

  const generate = async () => {
    setLoading(true);
    setReport(\"\");
    try {
      const r = await axios.post(`${API}/ai/generate-report`, { city, zone_id: zoneId || null });
      setReport(r.data.report);
    } catch (e) {
      setReport(\"Report generation failed. Please try again.\");
    }
    setLoading(false);
  };

  return (
    <div className=\"space-y-6\">
      <div>
        <h1 className=\"text-3xl font-bold\">AI Recommendations</h1>
        <p className=\"text-slate-500 dark:text-slate-400\">
          Generate a full operational report tailored to the city or a specific zone.
        </p>
      </div>

      <div className=\"rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5\">
        <div className=\"grid sm:grid-cols-3 gap-3\">
          <div className=\"sm:col-span-2\">
            <label className=\"text-xs text-slate-500\">Focus zone (optional)</label>
            <select
              value={zoneId} onChange={(e) => setZoneId(e.target.value)}
              data-testid=\"ai-zone-select\"
              className=\"w-full mt-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-2 text-sm\"
            >
              <option value=\"\">— City-wide overview —</option>
              {zones.map((z) => <option key={z.id} value={z.id}>{z.name}</option>)}
            </select>
          </div>
          <div className=\"flex items-end\">
            <button
              onClick={generate} disabled={loading}
              data-testid=\"generate-report-btn\"
              className=\"w-full inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 text-white py-2.5 font-semibold transition\"
            >
              <Sparkles size={16} /> {loading ? \"Generating…\" : \"Generate Full Report\"}
            </button>
          </div>
        </div>
      </div>

      <div className=\"rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 min-h-[300px]\">
        <div className=\"flex items-center gap-2 mb-3 text-emerald-600\">
          <FileText size={18} /> <span className=\"font-semibold\">Operational Report</span>
        </div>
        {!report ? (
          <p className=\"text-slate-500 text-sm\">Click \"Generate Full Report\" to produce a structured operational report.</p>
        ) : (
          <pre data-testid=\"ai-report-output\" className=\"whitespace-pre-wrap text-sm leading-relaxed font-sans\">
            {report}
          </pre>
        )}
      </div>
    </div>
  );
}
"
