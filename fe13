
Action: file_editor create /app/frontend/src/pages/Registry.jsx --file-text "import React, { useMemo, useState } from \"react\";
import { useApp } from \"../AppContext\";
import { fillColor } from \"../components/MapView\";
import { ArrowUpDown, Search } from \"lucide-react\";

export default function Registry() {
  const { bins } = useApp();
  const [sort, setSort] = useState({ key: \"id\", asc: true });
  const [filter, setFilter] = useState(\"\");
  const [statusFilter, setStatusFilter] = useState(\"all\");

  const sorted = useMemo(() => {
    const f = bins.filter((b) => {
      const matchSearch = !filter || `${b.id} ${b.area} ${b.place}`.toLowerCase().includes(filter.toLowerCase());
      const matchStatus = statusFilter === \"all\" || b.status === statusFilter;
      return matchSearch && matchStatus;
    });
    return [...f].sort((a, b) => {
      const av = a[sort.key], bv = b[sort.key];
      if (av < bv) return sort.asc ? -1 : 1;
      if (av > bv) return sort.asc ? 1 : -1;
      return 0;
    });
  }, [bins, sort, filter, statusFilter]);

  const toggleSort = (key) =>
    setSort((s) => ({ key, asc: s.key === key ? !s.asc : true }));

  return (
    <div className=\"space-y-6\">
      <div>
        <h1 className=\"text-3xl font-bold\">Bin Registry</h1>
        <p className=\"text-slate-500 dark:text-slate-400\">All deployed bins with live status.</p>
      </div>

      <div className=\"flex flex-wrap gap-3\">
        <div className=\"relative flex-1 min-w-[220px]\">
          <Search size={16} className=\"absolute left-3 top-2.5 text-slate-400\" />
          <input
            value={filter} onChange={(e) => setFilter(e.target.value)}
            data-testid=\"registry-search\"
            placeholder=\"Search by ID, area, place…\"
            className=\"w-full pl-9 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 text-sm\"
          />
        </div>
        <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)}
                data-testid=\"registry-status-filter\"
                className=\"rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 text-sm\">
          <option value=\"all\">All statuses</option>
          <option value=\"heavy\">Heavy</option>
          <option value=\"moderate\">Moderate</option>
          <option value=\"light\">Light</option>
        </select>
      </div>

      <div className=\"rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden\">
        <div className=\"overflow-x-auto\">
          <table className=\"w-full text-sm\" data-testid=\"registry-table\">
            <thead className=\"bg-slate-50 dark:bg-slate-800\">
              <tr>
                {[
                  [\"id\", \"Bin ID\"], [\"area\", \"Area\"], [\"place\", \"Place\"],
                  [\"fill_percent\", \"Fill %\"], [\"status\", \"Status\"], [\"capacity_liters\", \"Capacity\"],
                ].map(([k, label]) => (
                  <th key={k} className=\"text-left p-3 font-semibold cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-700\"
                      data-testid={`sort-${k}`}
                      onClick={() => toggleSort(k)}>
                    <span className=\"inline-flex items-center gap-1\">{label} <ArrowUpDown size={12} className=\"opacity-50\" /></span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {sorted.map((b) => (
                <tr key={b.id} className=\"border-t border-slate-100 dark:border-slate-800 hover:bg-emerald-50/50 dark:hover:bg-slate-800/50\">
                  <td className=\"p-3 font-mono font-bold text-emerald-700\">{b.id}</td>
                  <td className=\"p-3\">{b.area}</td>
                  <td className=\"p-3\">{b.place}</td>
                  <td className=\"p-3 font-bold\" style={{ color: fillColor(b.fill_percent) }}>{b.fill_percent}%</td>
                  <td className=\"p-3\">
                    <span className=\"px-2 py-0.5 rounded text-xs text-white\"
                          style={{ background: fillColor(b.fill_percent) }}>
                      {b.status.toUpperCase()}
                    </span>
                  </td>
                  <td className=\"p-3\">{b.capacity_liters} L</td>
                </tr>
              ))}
              {sorted.length === 0 && (
                <tr><td colSpan={6} className=\"p-6 text-center text-slate-500\">No bins match.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
"
